# ─────────────────────────────────────────────────────────
# Trumpet PHP Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# ── Database (MySQL 8) ───────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trumpet
DB_USER=trumpet_user
DB_PASS=change-me

# ── API Security ─────────────────────────────────────────
# All /api/* requests must include header:  X-API-Key: <value>
API_KEY=change-me-in-production

# ── Azure Blob Storage ───────────────────────────────────
# Leave blank to fall back to local /media/ serving via Nginx.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=media

# ── Local Media Fallback ─────────────────────────────────
# Used only when AZURE_STORAGE_CONNECTION_STRING is empty.
RESOURCES_PATH=/var/www/trumpet/resources

# ── Python CLI (tagging / recommendation) ────────────────
PYTHON_BIN=/usr/bin/python3
PYTHON_SERVICES_PATH=/var/www/trumpet/python_services
