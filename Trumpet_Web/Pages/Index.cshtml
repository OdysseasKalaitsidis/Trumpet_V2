@page
@using Microsoft.EntityFrameworkCore
@using Trumpet.Shared
@model IndexModel
@{
    ViewData["Title"] = "Corfiot Music Archive";
}

<div class="text-center mb-5">
    <h1 class="display-4">Corfiot Music Archive</h1>
    <p class="lead">Select a Music Path to explore the archive.</p>
</div>

<!-- Music Paths Navigation -->
<div class="row mb-5 justify-content-center">
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="card h-100 shadow-sm text-center">
            <div class="card-body d-flex flex-column justify-content-center align-items-center">
                <img src="~/img/art_music.png" alt="Art Music icon" class="img-fluid mb-3 path-icon" style="max-height: 130px; object-fit: contain;">
                <h5>Art Music</h5>
                <p class="text-muted small">(Η μουσική του άστεως)</p>
                <a href="/?path=ArtMusic" class="btn btn-primary mt-2">Explore</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="card h-100 shadow-sm text-center">
            <div class="card-body d-flex flex-column justify-content-center align-items-center">
                <img src="~/img/urban_popular.png" alt="Urban Popular Music icon" class="img-fluid mb-3 path-icon" style="max-height: 130px; object-fit: contain;">
                <h5>Urban Popular Music</h5>
                <p class="text-muted small">(Η αστικολαϊκή μουσική)</p>
                <a href="/?path=UrbanPopular" class="btn btn-primary mt-2">Explore</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="card h-100 shadow-sm text-center">
            <div class="card-body d-flex flex-column justify-content-center align-items-center">
                <img src="~/img/rural_music.png" alt="Rural Music icon" class="img-fluid mb-3 path-icon" style="max-height: 130px; object-fit: contain;">
                <h5>Rural Music</h5>
                <p class="text-muted small">(Η μουσική της υπαίθρου)</p>
                <a href="/?path=RuralMusic" class="btn btn-primary mt-2">Explore</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="card h-100 shadow-sm text-center">
            <div class="card-body d-flex flex-column justify-content-center align-items-center">
                <img src="~/img/sacred_music.png" alt="Sacred Music icon" class="img-fluid mb-3 path-icon" style="max-height: 130px; object-fit: contain;">
                <h5>Sacred Music</h5>
                <p class="text-muted small">(Η εκκλησιαστική μουσική)</p>
                <a href="/?path=SacredMusic" class="btn btn-primary mt-2">Explore</a>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
    <h2>@Model.PathTitle</h2>
    @if (!string.IsNullOrEmpty(Model.SelectedPath))
    {
        <a href="/" class="btn btn-outline-secondary">Show All Archives</a>
    }
</div>
<p class="text-muted mb-4">Found @Model.Items.Count items in this path.</p>

<div class="container">
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
        @foreach (var item in Model.Items)
        {
            var coverImage = Trumpet_Web.Services.ImageHelper.GetBestCoverImage(item);
            string imageUrl = "";
            
            if (coverImage != null)
            {
               int outIndex = coverImage.LocalFilePath.IndexOf("out" + System.IO.Path.DirectorySeparatorChar);
               if (outIndex >= 0)
               {
                   imageUrl = "/media/" + coverImage.LocalFilePath.Substring(outIndex + 4).Replace("\\", "/");
               }
            }

            // Fallback: If no good image, check for PDF
            string pdfUrl = "";
            if (string.IsNullOrEmpty(imageUrl))
            {
                var pdfBitstream = item.Bitstreams.FirstOrDefault(b => b.MimeType == "application/pdf" || b.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase));
                if (pdfBitstream != null)
                {
                    int outIndex = pdfBitstream.LocalFilePath.IndexOf("out" + System.IO.Path.DirectorySeparatorChar);
                    if (outIndex >= 0)
                    {
                        pdfUrl = "/media/" + pdfBitstream.LocalFilePath.Substring(outIndex + 4).Replace("\\", "/");
                    }
                }
            }

            <div class="col">
                <a href="/Item/@item.Id" class="text-decoration-none text-dark">
                    <div class="card h-100 shadow-sm border-0 item-card">
                        @if (!string.IsNullOrEmpty(imageUrl))
                        {
                            <img src="@imageUrl" class="card-img-top" alt="@item.Name" style="height: 250px; object-fit: cover;">
                        }
                        else if (!string.IsNullOrEmpty(pdfUrl))
                        {
                            <canvas class="pdf-thumb card-img-top" data-url="@pdfUrl" style="height: 250px; object-fit: cover; background: #f8f9fa;"></canvas>
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 250px;">
                                <span class="text-muted fs-1">🎵</span>
                            </div>
                        }
                        <div class="card-body">
                            <h6 class="card-title text-truncate" title="@item.Name">@item.Name</h6>
                            @{
                                var author = item.Metadata.FirstOrDefault(m => m.Field == "dc.contributor.author")?.Value;
                                if (!string.IsNullOrEmpty(author))
                                {
                                     <p class="card-text small text-muted text-truncate">@author</p>
                                }
                            }
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

@functions {
    public class IndexModel : Microsoft.AspNetCore.Mvc.RazorPages.PageModel
    {
        private readonly MusicContext _db;
        public List<Item> Items { get; set; } = new();

        public IndexModel(MusicContext db)
        {
            _db = db;
        }

        public string? SelectedPath { get; set; }
        public string PathTitle { get; set; } = "All Archives";

        public void OnGet(string? path)
        {
            SelectedPath = path;

            IQueryable<Item> query = _db.Items
                       .Include(i => i.Metadata)
                       .Include(i => i.Bitstreams)
                       .Where(i => i.Bitstreams.Count > 0);

            if (!string.IsNullOrEmpty(path))
            {
                // Mapping logic based on metadata 'dc.musicsubpath'
                var searchValues = new List<string>();

                switch (path)
                {
                    case "ArtMusic":
                        PathTitle = "Η μουσική του άστεως (Art Music)";
                        searchValues.AddRange(new[] { "Art music", "Μουσική του Άστεως", "Μουσική του άστεως" });
                        break;
                    case "UrbanPopular":
                        PathTitle = "Η αστικολαϊκή μουσική (Urban Popular Music)";
                        searchValues.AddRange(new[] { "Urban popular music", "Αστικολαϊκή μουσική" });
                        break;
                    case "RuralMusic":
                        PathTitle = "Η μουσική της υπαίθρου (Rural Music)";
                        searchValues.AddRange(new[] { "Rural music", "Μουσική της υπαίθρου" });
                        break;
                    case "SacredMusic":
                        PathTitle = "Η εκκλησιαστική μουσική (Sacred Music)";
                        searchValues.AddRange(new[] { "Sacred music", "Εκκλησιαστική μουσική" });
                        break;
                }

                if (searchValues.Any())
                {
                    // Filter items by metadata 'dc.musicsubpath'
                    // We need to join with MetadataValues
                    query = query.Where(i => i.Metadata.Any(m => m.Field == "dc.musicsubpath" && searchValues.Contains(m.Value)));
                }
            }

            Items = query.OrderBy(i => i.Name)
                       .Take(1000) // Increased limit to see results
                       .ToList();
        }
    }
}