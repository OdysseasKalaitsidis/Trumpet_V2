# Trumpet Python Backend Configuration
# -----------------------------------

# 1. Database
# sqlite:///../data/database/trumpet.db (Existing SQLite) or a production SQL Server/Postgres URL
DATABASE_URL=sqlite:///../data/database/trumpet.db

# 2. Azure Blob Storage
# Connection string from Azure Portal
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
AZURE_CONTAINER_NAME=media

# 3. Security
# Update with your actual frontend URLs (separate by commas)
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.azurewebsites.net

# 4. App Settings
RESOURCES_PATH=../resources
LOG_LEVEL=INFO
